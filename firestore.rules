rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && exists(path)
        && get(path).data.membershipApproved == true
        && get(path).data.disabled == false
        && get(path).data.email.lower() == request.auth.token.email.lower();
    }

    function isEmailVerified() {
      return isSignedIn();
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    function isEmployee() {
      return isSignedIn() && getUserRole() in ['admin', 'employee'];
    }

    function isOwner() {
      return isSignedIn() && getUserRole() == 'owner';
    }

    function isViewer() {
      return isSignedIn() && getUserRole() == 'viewer';
    }

    function getUserRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : 'none';
    }

    function ownerRecordId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('ownerRecordId', request.auth.uid);
    }

    function isHorseOwner(horseData) {
      return (isOwner() || isViewer()) && horseData.ownerId == ownerRecordId();
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'displayName', 'role', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['admin', 'employee', 'owner', 'viewer']
        && (!('phoneNumber' in data) || data.phoneNumber is string)
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidHorse(data) {
      return data.keys().hasAll(['name', 'ownerId', 'status', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() <= 100
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.status in ['active', 'training', 'sick', 'sold', 'archived', 'boarding', 'boarding_breeding', 'private']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMealType(data) {
      return data.keys().hasAll(['name', 'unit', 'pricePerUnit', 'currentStock', 'minThreshold'])
        && data.name is string && data.name.size() <= 100
        && data.unit is string && data.unit.size() <= 20
        && data.pricePerUnit is number && data.pricePerUnit >= 0
        && data.currentStock is number
        && data.minThreshold is number;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['name', 'cost', 'frequency', 'createdAt'])
        && data.name is string && data.name.size() <= 200
        && data.cost is number && data.cost >= 0
        && data.frequency in ['once', 'daily', 'weekly', 'monthly']
        && data.createdAt is timestamp
        && (!('horseIds' in data) || (data.horseIds is list && (data.horseIds.size() == 0 || data.horseIds[0] is string)));
    }

    function isValidIncome(data) {
      return data.keys().hasAll(['horseId', 'amount', 'dueDate', 'status'])
        && data.horseId is string && data.horseId.size() <= 128
        && data.amount is number && data.amount >= 0
        && data.status in ['pending', 'collected']
        && data.dueDate is timestamp;
    }

    function isValidRegistrationRequest(data) {
      return data.keys().hasAll(['ownerId', 'horseName', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() <= 128
        && data.horseName is string && data.horseName.size() <= 100
        && data.status in ['pending', 'reviewing', 'awaiting_owner_approval', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isEmployee());
      allow list: if isEmployee();
      // Memberships and roles are managed by verified administrator Cloud Functions.
      allow create, delete: if false;
      allow update: if isSignedIn() && request.auth.uid == userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName','photoURL','phoneNumber']);
    }
    match /users/{userId}/staffAlerts/{alertId} {
      allow read: if isSignedIn() && request.auth.uid == userId && (isEmployee() || resource.data.kind == 'app_update');
      allow update: if isSignedIn() && request.auth.uid == userId && (isEmployee() || existing().kind == 'app_update') && incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read is bool;
      allow create, delete: if false;
    }
    match /pushDevices/{deviceId} { allow read, write: if false; }
    match /stockAlertState/{itemId} { allow read, write: if false; }
    match /staffAlertEvents/{eventId} { allow read, write: if false; }
    match /appUpdateState/{versionId} { allow read, write: if false; }

    // 1. Horses Collection
    match /owners/{ownerId} {
      allow read: if isEmployee();
      allow write: if false; // Business records and account links are managed on the server.
    }
    match /horses/{horseId} {
      allow get: if isEmployee() || isHorseOwner(existing());
      allow list: if isEmployee() || ((isOwner() || isViewer()) && resource.data.ownerId == ownerRecordId());
      allow create: if isEmployee() && isValidHorse(incoming()) && !incoming().keys().hasAny(['accountVersion','accountAnchor','accountCycles','accountExtras','boardingHistory','billingPolicy','stayPeriods','feedingHistory','feedingSkips']);
      allow update: if isEmployee() && isValidHorse(incoming()) && !incoming().diff(existing()).affectedKeys().hasAny(['accountVersion','accountAnchor','accountCycles','accountExtras','boardingHistory','billingPolicy','stayPeriods','feedingHistory','feedingSkips']) && (!existing().keys().hasAny(['feedingHistory']) || !incoming().diff(existing()).affectedKeys().hasAny(['feeding','entryDate','exitDate','status'])) && (existing().get('accountVersion',0) != 1 || !incoming().diff(existing()).affectedKeys().hasAny(['dueDate','boardingFee','ownerId']));
      allow delete: if isAdmin() && existing().get('accountVersion',0) != 1 && !existing().keys().hasAny(['boardingHistory']);
    }

    // 3. Meal Types & Inventory
    match /mealTypes/{mealTypeId} {
      allow read: if isEmployee() || isOwner() || isViewer();
      allow create: if isEmployee() && isValidMealType(incoming()) && isValidId(mealTypeId) && !incoming().keys().hasAny(['autoFeedingFrom','autoFeedingThrough','stockReconciledAt']);
      allow update: if isEmployee() && isValidMealType(incoming()) && isValidId(mealTypeId) && !incoming().diff(existing()).affectedKeys().hasAny(['autoFeedingFrom','autoFeedingThrough','stockReconciledAt']) && (!existing().keys().hasAny(['autoFeedingFrom']) || !incoming().diff(existing()).affectedKeys().hasAny(['currentStock','feedingUnit','feedingUnitsPerPurchaseUnit','unit']));
      allow delete: if isAdmin() && !existing().keys().hasAny(['autoFeedingFrom']);
    }

    // 4. Meal Configs (Subcollection or linked by ID)
    // Here we use a different path if we want to allow easier queries
    match /horses/{horseId}/meals/{mealId} {
      allow read: if isEmailVerified() && (isEmployee() || isHorseOwner(get(/databases/$(database)/documents/horses/$(horseId)).data));
      allow write: if isEmployee() && isValidId(mealId);
    }

    // 5. Feeding Logs
    match /feedingLogs/{logId} {
      allow read: if isEmailVerified() && (isEmployee() || isHorseOwner(get(/databases/$(database)/documents/horses/$(existing().horseId)).data));
      allow create: if isEmployee() && isValidId(logId);
    }

    // 6. Inventory Transactions
    match /inventoryTransactions/{txId} {
      allow read: if isEmployee();
      allow create: if isEmployee() && isValidId(txId) && !txId.matches('^feeding_.*') && !incoming().keys().hasAny(['feedingDate','breakdown','reversalSources']) && incoming().get('movementKind','manual') in ['manual','add','remove'];
    }

    // 7. Notifications
    match /notifications/{notifId} {
      allow read: if isEmailVerified() && resource.data.userId == request.auth.uid;
      allow update: if isEmailVerified() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isEmployee(); // System/Admin/Employee can notify
    }

    // 8. Expenses Collection
    match /expenses/{expenseId} {
      allow read: if isEmployee() || ((isOwner() || isViewer()) && request.auth.uid in resource.data.get('horseIds', []));
      allow create: if isEmployee() && isValidExpense(incoming());
      allow update: if isEmployee() && isValidExpense(incoming()) && !existing().get('lockedForPayments', false) && !existing().get('lockedForReceipts',false);
      allow delete: if isAdmin() && !existing().get('lockedForPayments', false) && !existing().get('lockedForReceipts',false);
    }
    // 4. Settings Collection (Stable Identity)
    match /expensePayments/{paymentId} {
      allow read: if isEmployee();
      allow write: if false;
    }
    match /financialPeriods/{periodId} {
      allow read: if isEmployee();
      allow write: if false;
    }
    match /financialReports/{reportId} {
      allow read: if isEmployee();
      allow write: if false;
    }
    match /settings/{docId} {
      allow read: if true; // Allow public read for logo and name on landing page
      allow write: if isAdmin();
    }

    // 9. Activities Collection
    match /activities/{activityId} {
      allow list: if isEmployee() || ((isOwner() || isViewer()) && resource.data.ownerId == ownerRecordId());
      allow get: if isEmployee() || ((isOwner() || isViewer()) && resource.data.ownerId == ownerRecordId());
      allow create: if isSignedIn();
    }

    // 10. Incomes Collection
    match /incomes/{incomeId} {
      allow read: if isEmployee() || ((isOwner() || isViewer()) && resource.data.ownerId == ownerRecordId());
      allow create: if isEmployee() && isValidIncome(incoming()) && !incoming().keys().hasAny(['accountVersion']) && get(/databases/$(database)/documents/horses/$(incoming().horseId)).data.get('accountVersion',0) != 1;
      allow update: if isEmployee() && isValidIncome(incoming()) && existing().get('accountVersion',0) != 1 && !incoming().keys().hasAny(['accountVersion']);
      allow delete: if isAdmin() && existing().get('accountVersion',0) != 1;
    }

    match /income/{incomeId} {
      allow read: if isEmployee() || ((isOwner() || isViewer()) && resource.data.ownerId == ownerRecordId());
      allow write: if false;
    }
    match /memberInvitations/{invitationId} { allow read, write: if false; }
    // 11. Registration Requests
    match /registrationRequests/{requestId} {
      allow list: if isEmployee() || (isSignedIn() && resource.data.ownerId == ownerRecordId());
      allow get: if isEmployee() || (isSignedIn() && resource.data.ownerId == ownerRecordId());
      allow create: if isSignedIn() && isValidRegistrationRequest(incoming()) && incoming().ownerId == ownerRecordId();
      allow update: if isSignedIn() && (
        (isEmployee() && isValidRegistrationRequest(incoming())) ||
        (resource.data.ownerId == ownerRecordId() && incoming().status in ['approved', 'rejected'] && existing().status == 'awaiting_owner_approval' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }
  }
}
