rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function active(){return signed() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false;}
  function role(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;}
  function staff(){return active() && role() in ['admin','employee'];}
  function mine(){return active() && resource.data.ownerId == request.auth.uid;}
  match /settings/{id}{allow read: if true;}
  match /users/{id}{allow read: if active() && (staff() || id == request.auth.uid);}
  match /horses/{id}{allow read: if staff() || mine();}
  match /registrationRequests/{id}{allow read: if staff() || mine();}
  match /income/{id}{allow read: if staff() || mine();}
  match /activities/{id}{allow read: if staff() || mine();}
  match /mealTypes/{id}{allow read: if staff();}
  match /inventoryTransactions/{id}{allow read: if staff();}
  match /expenses/{id}{allow read: if staff();}
  // All writes go through authenticated Cloud Functions and atomic transactions.
  match /{document=**}{allow write: if false;}
 }
}
