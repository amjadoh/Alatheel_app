# Set true only for the isolated local demonstration. Never uses Firebase in demo mode.
VITE_DEMO_MODE=true
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_FUNCTIONS_REGION=us-central1
# Optional deployed HTTPS app URL for horse QR links
VITE_PUBLIC_APP_URL=
